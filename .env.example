# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Shared admin draft API origin.
# Leave empty to use same-origin requests such as /api/... and /v1/...
VITE_API_BASE_URL=http://localhost:8080

# Gemini image editing.
VITE_GEMINI_API_KEY=your_gemini_api_key

# Target-specific publish origins for product draft publish.
# These are separate from VITE_API_BASE_URL because draft reads/writes use the
# shared draft API, while publish requests route by target.
VITE_PUBLISH_API_BASE_URL_PRODUCTION=https://api.peasydeal.com
VITE_PUBLISH_API_BASE_URL_STAGING=https://staging-api.peasydeal.com
